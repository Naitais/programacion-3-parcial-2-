# ============================================================
# ARCHIVO .env  -  configuracion del backend
# ============================================================
# Este archivo NO se sube a GitHub (esta en .gitignore) porque
# tiene la contrasenia de la base y la clave de los tokens.
#
# IMPORTANTE: revisa DB_PORT y DB_PASSWORD segun tu instalacion
# de MySQL. Si usas el puerto por defecto, poné 3306.
# ============================================================

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=gestion_turnos
DB_PORT=3307

# Puerto donde escucha el backend
PORT=3000

# Clave con la que se firman los tokens JWT.
# Si se cambia, todos los tokens emitidos antes dejan de valer.
JWT_SECRET=pone_una_clave_larga_y_secreta
